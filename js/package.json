  "homepage": "https://github.com/garag0l/turkmen-translit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garag0l/turkmen-translit.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/garag0l/turkmen-translit/issues"
  },
  "engines": {
    "node": ">=18"
  }
